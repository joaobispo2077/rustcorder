# Rust and native build output (Cargo.lock stays versioned for this application).
/target/
/debug/
/release/
/build/
/bin/
/obj/
*.obj
*.pdb
*.ilk
*.exp
*.pch
*.exe
*.dll
*.lib
*.a
*.rs.bk
*.rlib
*.prof*

# Local toolchains, downloaded assets, private output and portable packages.
/.build/
/models/
/recordings/
/transcripts/
/transcript*.txt
/dist/
*.bin
*.ggml
*.gguf
*.onnx
*.safetensors
*.pt
*.pth

# Audio is private by default; intentional redistributable test fixtures are allowed.
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.opus
*.wma
!/tests/fixtures/**/*.wav
!/tests/fixtures/**/*.mp3
!/tests/fixtures/**/*.flac
!/tests/fixtures/**/*.m4a
!/tests/fixtures/**/*.aac
!/tests/fixtures/**/*.ogg
!/tests/fixtures/**/*.opus
!/tests/fixtures/**/*.wma

# Local environment, diagnostics and development caches.
.env
.env.*
!.env.example
!.env.sample
*.log
__pycache__/
*.pyc
/.cache/
/.claude/settings.local.json

# Editor and operating-system files.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.swp

# CI-only tools, reports and mutation output.
node_modules/
/reports/
/mutants.out/
/mutants.out.old/
/.stryker-tmp/
