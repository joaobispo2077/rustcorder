{
  "name": "rustcorder-ci",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check gates.mjs && node --check release.mjs && node --check report.mjs",
    "mutation": "stryker run stryker.config.mjs"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@stryker-mutator/core": "10.1.1",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "jscpd": "5.4.2",
    "semver": "7.7.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1",
    "qs": "6.16.1",
    "semantic-release": "25.0.8"
  }
}
